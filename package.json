{
  "name": "dsh-ahoy",
  "version": "0.0.1",
  "description": "在这一台 DeepSeek Harness 里看见并委派其他机器上的 Harness。每台机器仍自己思考、自己动手。",
  "type": "module",
  "engines": {
    "node": ">=24.9"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "tsdown": "0.23.1",
    "typescript": "~7.0.2"
  }
}
